{
  "name": "chess-club-ranking",
  "version": "1.0.0",
  "description": "Chess Club Ranking System - DevOps Project Part 1",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "prepare": "husky",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:jest && playwright test",
    "test:jest": "jest",
    "test:backend": "jest --testPathPattern=backend_unit",
    "test:api": "jest --testPathPattern=api",
    "test:frontend": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:create": "jest --testPathPattern=create_function && playwright test tests/create_function/frontend",
    "test:jest:coverage": "jest --coverage",
    "test:playwright:coverage": "playwright test",
    "test:ci": "npm run test:jest:coverage && playwright test --project=frontend-chromium --project=frontend-firefox --project=frontend-webkit",
    "test:coverage": "npm run test:jest:coverage && npm run test:playwright:coverage",
    "coverage:report": "node scripts/generate-frontend-coverage.js"
  },
  "keywords": [
    "chess",
    "ranking",
    "devops"
  ],
  "author": "Team Members",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2",
    "express-status-monitor": "^1.3.4",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "eslint": "^8.57.0",
    "husky": "^9.1.7",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.1.0",
    "supertest": "^7.0.0",
    "v8-to-istanbul": "^9.3.0"
  }
}
