{
  "name": "chess-club-ranking",
  "version": "1.0.0",
  "description": "Chess Club Ranking System - DevOps Project Part 1",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "prepare": "husky",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:jest && npm run test:playwright",
    "test:jest": "jest",
    "test:backend": "jest --testPathPattern=backend_unit",
    "test:api": "jest --testPathPattern=api",
    "test:playwright": "playwright test",
    "test:frontend": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:create": "jest --testPathPattern=create_function && playwright test tests/create_function/frontend",
    "test:jest:coverage": "jest --coverage",
    "test:playwright:coverage": "c8 playwright test",
    "test:coverage": "npm run test:jest:coverage && npm run test:playwright:coverage",
    "test:coverage:report": "c8 report --reporter=html --reporter=text"
  },
  "keywords": [
    "chess",
    "ranking",
    "devops"
  ],
  "author": "Team Members",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "c8": "^10.1.3",
    "eslint": "^8.57.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.1.0",
    "supertest": "^7.0.0"
  }
}
