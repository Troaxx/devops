{
  "name": "chess-club-ranking",
  "version": "1.0.0",
  "description": "Chess Club Ranking System - DevOps Project Part 1",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "prepare": "husky",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "jest",
    "test:unit": "jest unit",
    "test:api": "jest api",
    "test:frontend": "playwright test",
    "test:frontend:ui": "playwright test --ui",
    "test:frontend:headed": "playwright test --headed",
    "test:coverage": "jest --coverage",
    "test:coverage:backend": "jest --coverage",
    "test:coverage:frontend": "node generate-playwright-coverage.js",
    "test:watch": "jest --watch",
    "playwright:install": "playwright install",
    "playwright:report": "playwright show-report"
  },
  "keywords": [
    "chess",
    "ranking",
    "devops"
  ],
  "author": "Team Members",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "c8": "^10.1.3",
    "eslint": "^8.57.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.1.0",
    "supertest": "^7.2.2"
  }
}
